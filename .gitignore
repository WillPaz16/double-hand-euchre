# Dependencies and build output
node_modules/
dist/

# Wrangler: local Durable Object storage from `wrangler dev`, local secrets, and generated
# runtime types (`npm run typecheck:worker` regenerates them from wrangler.jsonc).
.wrangler/
.dev.vars*
worker-configuration.d.ts

# Environment files. `.env.development` IS committed: it only points the dev client at
# ws://localhost:8787 and holds no secrets. Anything else could.
.env
.env.*
!.env.development

# Test and audit artifacts
coverage/
test-results/
playwright-report/

# Python bytecode from running the art generators
__pycache__/
*.pyc

# Logs and OS/editor noise
*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/

# Local AI tooling — personal to one machine (absolute paths, plugin config), not project source
.claude/
CLAUDE.md
graphify-out/
