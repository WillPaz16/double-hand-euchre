// One Worker serving the built client AND the multiplayer rooms, on one origin.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // `doublehand`, not `euchre` (direct user request: a nicer free URL, no domain purchase). The
  // Worker name IS the first label of the workers.dev address, so this reads
  // doublehand.willpaz16.workers.dev. Renaming a Worker creates a NEW one with its own, empty
  // Durable Object namespace, so rooms in progress under the old name do not carry over.
  "name": "doublehand",
  // Pinned so a CI deploy with an API token never has to guess which account it means. An
  // identifier, not a credential: the token is what grants access, and it lives in GitHub secrets.
  "account_id": "429366780e573713be56dcd29b89138e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, SPA fallback answers `/ws` with index.html before the Worker ever runs, and
    // every socket upgrade quietly becomes a 200 of HTML.
    "run_worker_first": ["/ws", "/health", "/report"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
  },

  // `new_sqlite_classes`, not `new_classes`: only SQLite-backed Durable Objects are available on
  // the Workers Free plan. The key-value storage API used in room-object.ts works on both.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],

  // Unset (empty) means allow any origin — correct here, since this Worker serves its own client.
  "vars": { "ALLOWED_ORIGINS": "" },

  // Abuse guards. Anyone can open sockets at guessed room codes, and each one wakes a Durable
  // Object and writes storage — enough of that burns the free plan's daily budget and takes the
  // game down until it resets. Counted per Cloudflare location and eventually consistent, which is
  // the right shape here: a blunt ceiling on floods, not an accounting system. Periods may only be
  // 10 or 60 seconds. The socket limit is far above real play (a game opens one socket, plus a few
  // on reconnects); the report limit is deliberately tight, since a page in a crash loop would
  // otherwise report forever.
  "ratelimits": [
    { "name": "WS_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  // 8787 so `.env.development`'s VITE_SERVER_URL keeps pointing at the right place when the
  // client runs under Vite's HMR on :5173.
  "dev": { "port": 8787 },

  "observability": { "enabled": true },

  // DEV: pushes to the `dev` branch deploy here (see .github/workflows/ci.yml), production is
  // `main`. `wrangler deploy --env dev` names the Worker `doublehand-dev`, so it gets its own URL
  // (doublehand-dev.willpaz16.workers.dev) and its OWN Durable Object namespace — a dev room code
  // and a prod room code never meet, so testing can't disturb a real game.
  //
  // `durable_objects` and `vars` are repeated because wrangler does NOT inherit them into named
  // environments (its schema says so for both); leave either out and the dev Worker deploys
  // without a ROOM binding and every socket fails. `assets` and `migrations` DO inherit.
  "env": {
    "dev": {
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
      },
      "vars": { "ALLOWED_ORIGINS": "" },
      // Repeated for the same reason as `durable_objects` and `vars` above: wrangler's schema
      // says rate limits are NOT inherited into a named environment. Caught live — dev deployed
      // without them and 8 rapid /report posts all succeeded when the limit is 5. Separate
      // namespace ids from production, so a test flood on dev cannot use up prod's budget.
      "ratelimits": [
        { "name": "WS_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "REPORT_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
