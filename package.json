{
  "name": "double-hand-euchre",
  "version": "1.0.0",
  "description": "Four-hand euchre for two players — each of you plays both hands of a partnership. React + TypeScript, multiplayer on Cloudflare Durable Objects.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/WillPaz16/double-hand-euchre.git"
  },
  "homepage": "https://doublehand.willpaz16.workers.dev",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fuzz": "tsx scripts/fuzz.ts",
    "dev": "vite",
    "build": "tsc --noEmit && npm run typecheck:worker && vite build",
    "preview": "vite preview",
    "balance": "tsx scripts/balance.ts",
    "audit": "tsx scripts/audit.ts",
    "art:check": "python3 art/check_determinism.py && python3 art/check_cards_frozen.py && python3 art/check_avatar_holes.py",
    "worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck:worker": "wrangler types >/dev/null && tsc --noEmit -p worker/tsconfig.json",
    "deploy:dev": "npm run build && wrangler deploy --env=dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
