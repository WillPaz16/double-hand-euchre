{"nodes": [{"id": "rules_document", "label": "RULES.md \u2014 Two-Handed Euchre Rules Spec", "file_type": "document", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_setup", "label": "\u00a71 Setup", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_loner_declaration_windows", "label": "\u00a72 Loner Declaration Windows", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_full_blind_loner", "label": "Full-Blind Loner (8 points)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_blind_trump_loner", "label": "Blind-Trump Loner (6 points)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_standard_loner", "label": "Standard Loner (4 points)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_sequential_first_refusal", "label": "Sequential First-Refusal Default", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-dealer decides first within each window; if they pass, dealer gets the same window before it closes. Matches every other bidding round in the game (\u00a73), so it's the same legalActions shape reused four times, not a special case."}, {"id": "rules_bidding", "label": "\u00a73 Bidding (standard, on/after the upcard)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_stick_the_dealer", "label": "Stick the Dealer (config flag, default on)", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If both players pass round 2, the dealer is forced to name a trump suit rather than a misdeal/redeal \u2014 chosen as the default to avoid redeal churn."}, {"id": "rules_redeal_default", "label": "Redeal Default (stick-the-dealer off)", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If stick-the-dealer is off and both pass round 2, the deal is thrown in and redealt by the same dealer. Config-only; flip the flag, no engine change."}, {"id": "rules_tier_2_3_dealer_exchange", "label": "\u00a74 Tiers 2 & 3 Dealer Exchange", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the maker declared blind-trump or full-blind, the dealer still receives the upcard and discards regardless of who is maker or whether the dealer is even involved in the bid \u2014 it's a mechanical consequence of the upcard existing, not a bidding action. Kept private, consistent with every other hand-content rule in the game."}, {"id": "rules_going_alone_mechanics", "label": "\u00a75 Going Alone \u2014 Mechanics", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_full_blind_resolution", "label": "Full-Blind Loner Hand Resolution", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved by sequencing, not actually ambiguous \u2014 blind selection (\u00a71) happens for both players before any loner window opens (\u00a72), so a full-blind declaration is always made with a selected hand already fixed; that selected hand is the lone hand. No separate rule needed."}, {"id": "rules_play", "label": "\u00a76 Play", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_trick_rotation_ring", "label": "Fixed Trick Rotation Ring", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ring set once at the start of the deal (depends on selected/blind status, not dealer role); only the starting point changes trick to trick, set by whichever hand won the previous trick. Standard euchre 'winner leads next' applied at the hand level instead of the player level \u2014 no extra state needed."}, {"id": "rules_visibility", "label": "Hand Visibility Rule", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the hand currently taking its turn is shown to its owner. A player flips between their two hands' views potentially twice within one trick \u2014 once at each hand's turn \u2014 never seeing both simultaneously."}, {"id": "rules_scoring", "label": "\u00a77 Scoring", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_loner_sweep_bonus", "label": "Loner Sweep Scoring Bonus", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A loner who takes 3\u20134 tricks (doesn't sweep) scores the standard 1 point \u2014 the tiered bonus (4/6/8) applies only to a clean sweep. A loner who fails to take 3 is euchred exactly as normal: defenders get 2 points, regardless of tier."}, {"id": "rules_config_ts", "label": "config.ts Game-to-10 Constant", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Game to 10 points is the default, expressed as a config.ts constant, changeable with no logic change."}, {"id": "rules_misc_deferred", "label": "\u00a78 Misc \u2014 Defaults and Deferred Items", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_misdeal_conditions", "label": "Misdeal Conditions Default", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "None in v1 \u2014 the blind mechanic has no exposed-card-during-deal case, so there's nothing to misdeal on. Revisit only if a real deal produces a dispute."}, {"id": "rules_blind_hand_reveal", "label": "Blind Hand Reveal Default", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revealed to both players at the end of each deal, purely for table transparency/curiosity. Cosmetic \u2014 a UI flag, not an engine rule."}, {"id": "rules_dealer_alternation", "label": "Dealer Alternation Default", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dealer alternates every deal: standard, clockwise from the previous dealer."}, {"id": "rules_deferred_variant_rules", "label": "Deferred Variant Rules ('few crazy rules')", "file_type": "rationale", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not blocking Phase 1 since they're additive/variant rules layered on top of the resolved shell, not changes to it \u2014 they slot in as additional config or additional action types without touching what's above."}, {"id": "rules_hand_a1", "label": "Hand A1 (Player A, selected/blind)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_hand_a2", "label": "Hand A2 (Player A, selected/blind)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_hand_b1", "label": "Hand B1 (Player B, selected/blind)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_hand_b2", "label": "Hand B2 (Player B, selected/blind)", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_player_a", "label": "Player A", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rules_player_b", "label": "Player B", "file_type": "concept", "source_file": "RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rules_document", "target": "rules_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RULES.md", "source_location": null, "weight": 1.0}, {"source": "rules_document", "target": "rules_loner_declaration_windows", "relation": "references