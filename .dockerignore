# Everything the image builds for itself, plus everything that has no business in a build
# context. Keeping this tight matters for more than speed: `COPY . .` above would otherwise
# pull local .env files and room snapshots into an image that gets pushed to a registry.
node_modules
dist
dist-server
.git
.env
.env.local
.rooms.json
.rooms.json.tmp
.claude
graphify-out
tests
playwright-report
test-results
__pycache__
*.pyc
# Dev-only, points at localhost:8787, never read by `vite build` — but no reason to bake a
# development pointer into a production image.
.env.development
